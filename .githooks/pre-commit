#!/bin/sh
# Refuses the commit when the Gradle check task (bout logic tests, Kotlin format, Android lint) fails.
# shortcut: checks the working tree, not the staged snapshot; stash unstaged changes first once partial commits need checking.
# Prints the output of the check only when it fails: a passing check is about 150 lines of task names.
echo "pre-commit: ./gradlew check"
out=$(./gradlew check 2>&1) || {
    printf '%s\n' "$out"
    exit 1
}
